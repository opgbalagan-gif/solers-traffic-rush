{
  "name": "sollers-traffic-rush-local",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./out", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "sollers-local", "database_id": "00000000-0000-4000-8000-000000000000", "migrations_dir": "drizzle" }],
  "vars": { "CONTINUE_MODE": "alternate" },
  "dev": { "port": 4173 }
}
